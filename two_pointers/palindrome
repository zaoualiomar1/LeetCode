class Solution(object):
    def isPalindrome(self, s: str) -> bool :
        """
        :type s: str
        :rtype: bool
        """
        import re 
        
        # Working on the string 
        s = ''.join(char.lower() for char in s if char.isalnum())
        #s = re.sub(r'[^a-zA-A0-P]', '', s)# ou bien 
        
        # comparing every caracter 
        i,j = 0, len(s)-1  
        while i < j : 
            if s[i] != s[j]:
                return False 
            else :
                i+= 1 
                j-=1
            return True 
            
        